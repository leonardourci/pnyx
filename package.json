{
  "name": "pnyx-axi",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic board of every agent and its work, with an AXI CLI",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "pnyx-axi": "./dist/cli/pnyx-axi.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "pnpm run typecheck && eslint .",
    "test": "pnpm run build && node --test \"test/**/*.test.ts\"",
    "web:dev": "vite --config web/vite.config.ts",
    "test:web": "pnpm run build && node test/web-smoke.ts",
    "test:keyboard": "pnpm run build && node test/keyboard-smoke.ts",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "axi-sdk-js": "^0.1.13",
    "tinykeys": "^4.0.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
