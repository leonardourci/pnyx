{
  "license": "Apache-2.0",
  "name": "othrys",
  "version": "0.0.0",
  "private": true,
  "description": "Every agent and its work in Othrys",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "othrys": "./dist/cli/othrys.js"
  },
  "imports": {
    "#web-*": "./web/src/*",
    "#*.ts": {
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/build/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "pnpm run typecheck && eslint . && pnpm run lint:css",
    "test": "pnpm run build && vitest run",
    "web:dev": "NODE_OPTIONS=--conditions=source vite --configLoader native --config web/vite.config.ts",
    "dev": "OTHRYS_HOME=${OTHRYS_DEV_HOME:-$HOME/.othrys-dev} pnpm run \"/^(dev:server|web:dev)$/\"",
    "dev:server": "node --conditions=source --watch src/cli/othrys.ts serve --hydra dev --port ${OTHRYS_DEV_PORT:-4319}",
    "lint:fix": "eslint --fix .",
    "knip": "knip --tsConfig tsconfig.build.json",
    "verify": "pnpm run lint && pnpm test",
    "deslop": "deslop run",
    "refresh-agent-fixtures": "node scripts/fixtures/refresh-agent-fixtures.ts",
    "lint:css": "biome lint . --error-on-warnings"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tabler/icons-react": "3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "chrome-devtools-axi": "0.1.35",
    "chrome-devtools-mcp": "1.13.0",
    "deslop": "https://github.com/leonardourci/deslop/releases/download/v0.1.5/deslop.tgz",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "globals": "^17.13.0",
    "knip": "^6.46.1",
    "lenis": "^1.3.27",
    "marked": "^18.1.1",
    "motion": "14.14.0",
    "playwright-core": "1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.1.0",
    "zustand": "5.1.0"
  }
}
