{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ],
    "customConditions": [
      "source"
    ],
    "lib": [
      "ES2024",
      "ESNext.Iterator",
      "DOM"
    ]
  },
  "include": [
    "src",
    "scripts",
    "eslint",
    "e2e"
  ]
}
