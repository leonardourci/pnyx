{
  "main": "claude:personal",
  "workers": {
    "claude": [
      "claude:work",
      "claude:personal"
    ],
    "codex": [
      "codex:work",
      "codex:personal"
    ]
  },
  "projects": {},
  "rules": {
    "mechanical": {
      "when": "Trivial mechanical edit with an obvious path: rename, typo, formatting sweep, version bump, file gathering.",
      "candidates": [
        {
          "harness": "codex",
          "model": "gpt-6-luna",
          "effort": "low"
        },
        {
          "harness": "claude",
          "model": "claude-haiku-5-5",
          "effort": "low"
        }
      ]
    },
    "build": {
      "when": "Large or risky but well-defined implementation: multi-file features, refactors, migrations where the path is clear.",
      "candidates": [
        {
          "harness": "claude",
          "model": "claude-opus-5-5",
          "effort": "high"
        },
        {
          "harness": "codex",
          "model": "gpt-6.1-sol",
          "effort": "high"
        }
      ]
    },
    "investigate": {
      "when": "Ambiguous or open-ended work: unclear requirements, design, investigation, root-cause analysis, with or without code.",
      "candidates": [
        {
          "harness": "claude",
          "model": "claude-opus-5-5",
          "effort": "xhigh"
        },
        {
          "harness": "codex",
          "model": "gpt-6.1-sol",
          "effort": "xhigh"
        }
      ]
    }
  },
  "default": [
    {
      "harness": "claude",
      "model": "claude-sonnet-5-5",
      "effort": "medium"
    },
    {
      "harness": "codex",
      "model": "gpt-6.1-sol",
      "effort": "medium"
    }
  ]
}
