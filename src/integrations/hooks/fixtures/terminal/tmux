#!/bin/sh
# Stands in for tmux at the terminal boundary. Each load waits until two loads have happened,
# so two concurrent sends both load before either pastes. Pastes are logged as pane<TAB>text.
dir="$FAKE_TERMINAL_DIR"
shift 2
command="$1"
shift
case "$command" in
  display-message) echo /dev/ttys001 ;;
  load-buffer)
    cat > "$dir/buffer-$2"
    : > "$dir/loaded-$$"
    n=0
    while [ "$(ls "$dir" | grep -c '^loaded-')" -lt 2 ] && [ "$n" -lt 40 ]; do
      sleep 0.05
      n=$((n + 1))
    done
    ;;
  paste-buffer)
    printf '%s\t%s\n' "$6" "$(cat "$dir/buffer-$4")" >> "$dir/pasted"
    rm -f "$dir/buffer-$4"
    ;;
esac
exit 0
