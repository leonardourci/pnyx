#!/bin/sh
# Stands in for tmux at the terminal boundary: pane %1 shows /dev/ttys001, and each paste or key is logged.
# While $FAKE_TERMINAL_DIR/hold exists, a pressed key waits for it to go, so a test can act right after it.
dir="$FAKE_TERMINAL_DIR"
shift 2
command="$1"
for arg; do last="$arg"; done
case "$command" in
  display-message) echo /dev/ttys001 ;;
  load-buffer) printf 'paste %s\n' "$(cat)" >> "$dir/sent" ;;
  send-keys)
    printf 'key %s\n' "$last" >> "$dir/sent"
    n=0
    while [ -e "$dir/hold" ] && [ "$n" -lt 200 ]; do
      sleep 0.05
      n=$((n + 1))
    done
    ;;
esac
exit 0
