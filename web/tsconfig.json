{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "customConditions": [
      "source"
    ]
  },
  "include": [
    "."
  ]
}
