{
  "commands": {
    "lint:fix": "pnpm lint:fix",
    "typecheck": "pnpm typecheck",
    "eslint": "pnpm exec eslint .",
    "css": "pnpm lint:css",
    "build": "pnpm build",
    "tests": "pnpm exec vitest run",
    "integration": "pnpm exec vitest run --project=integration"
  },
  "kinds": [
    {
      "name": "workflow",
      "match": [
        ".github/workflows/*.{yml,yaml}"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "eslint",
        "css",
        "build",
        "tests"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "review-code",
        "audit-tests",
        "deslop",
        "write-ci-workflow"
      ],
      "ciRequired": true
    },
    {
      "name": "fixture",
      "match": [
        "**/fixtures/**"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "eslint",
        "css",
        "build",
        "tests"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "review-code",
        "audit-tests",
        "deslop"
      ],
      "ciRequired": true
    },
    {
      "name": "skill text",
      "match": [
        "skills/**/*.md"
      ],
      "commands": [
        "build",
        "integration"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "deslop"
      ],
      "ciRequired": true
    },
    {
      "name": "docs",
      "match": [
        "docs/**",
        "**/*.md"
      ],
      "commands": [],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "deslop"
      ]
    },
    {
      "name": "tests",
      "match": [
        "**/*.test.ts"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "eslint",
        "css",
        "build",
        "tests"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "audit-tests"
      ],
      "ciRequired": true
    },
    {
      "name": "UI",
      "match": [
        "web/**"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "eslint",
        "css",
        "build",
        "tests"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "review-code",
        "audit-tests",
        "deslop",
        "write-front-end"
      ],
      "ciRequired": true
    },
    {
      "name": "back-end",
      "match": [
        "**"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "eslint",
        "css",
        "build",
        "tests"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "review-code",
        "audit-tests",
        "deslop"
      ],
      "ciRequired": true
    }
  ],
  "instructions": {
    "project": "AGENTS.md",
    "review-code": ".agents/skills/review-code/SKILL.md",
    "audit-tests": ".agents/skills/audit-tests/SKILL.md",
    "deslop": ".agents/skills/deslop/SKILL.md",
    "write-front-end": ".agents/skills/write-front-end/SKILL.md",
    "write-ci-workflow": ".agents/skills/write-ci-workflow/SKILL.md"
  },
  "checkFixAttempts": 1,
  "publishLocal": false
}
