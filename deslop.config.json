{
  "commands": {
    "lint:fix": "pnpm lint:fix",
    "typecheck": "pnpm typecheck",
    "css": "pnpm lint:css",
    "build": "pnpm build"
  },
  "kinds": [
    {
      "name": "workflow",
      "match": [
        ".github/workflows/*.{yml,yaml}"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "css",
        "build"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "review-code",
        "audit-tests",
        "kill-ai-slop",
        "write-ci-workflow"
      ],
      "ciRequired": true,
      "try": "code"
    },
    {
      "name": "fixture",
      "match": [
        "**/fixtures/**"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "css",
        "build"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "review-code",
        "audit-tests",
        "kill-ai-slop"
      ],
      "ciRequired": true,
      "try": "code"
    },
    {
      "name": "skill text",
      "match": [
        "skills/**/*.md"
      ],
      "commands": [],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "kill-ai-slop"
      ],
      "ciRequired": true,
      "try": "code"
    },
    {
      "name": "docs",
      "match": [
        "docs/**",
        "**/*.md"
      ],
      "commands": [],
      "checks": [
        "Test scope"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "kill-ai-slop"
      ],
      "try": "code"
    },
    {
      "name": "tests",
      "match": [
        "**/*.test.ts"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "css",
        "build"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "audit-tests"
      ],
      "ciRequired": true,
      "try": "code"
    },
    {
      "name": "UI",
      "match": [
        "web/**"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "css",
        "build"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "review-code",
        "audit-tests",
        "kill-ai-slop",
        "write-front-end"
      ],
      "ciRequired": true,
      "try": "ui"
    },
    {
      "name": "back-end",
      "match": [
        "**"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "css",
        "build"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "review-code",
        "audit-tests",
        "kill-ai-slop"
      ],
      "ciRequired": true,
      "try": "code"
    }
  ],
  "instructions": {
    "project": "AGENTS.md",
    "write-front-end": ".agents/skills/write-front-end/SKILL.md",
    "write-ci-workflow": ".agents/skills/write-ci-workflow/SKILL.md",
    "follow-conventions": ".agents/skills/follow-conventions/SKILL.md"
  },
  "checkFixAttempts": 1,
  "agentTimeoutMinutes": 45,
  "tryNotes": "Run the web app with `PNYX_HOME=<scratch dir> pnpm dev` (Vite prints the URL; the dev server uses port 4319, set `PNYX_DEV_PORT` to change it) or an isolated `pnyx-axi serve --port 0`. Never touch the live install at pnyx.localhost or `~/.pnyx`; open the page in a headless browser with its own profile."
}
