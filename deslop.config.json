{
  "commands": {
    "lint:fix": "pnpm lint:fix",
    "typecheck": "pnpm typecheck",
    "css": "pnpm lint:css",
    "build": "pnpm build"
  },
  "kinds": [
    {
      "name": "workflow",
      "match": [
        ".github/workflows/*.{yml,yaml}"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "css",
        "build"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "review-code",
        "audit-tests",
        "kill-ai-slop",
        "write-ci-workflow"
      ],
      "ciRequired": true,
      "try": "code"
    },
    {
      "name": "fixture",
      "match": [
        "**/fixtures/**"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "css",
        "build"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "review-code",
        "audit-tests",
        "kill-ai-slop"
      ],
      "ciRequired": true,
      "try": "code"
    },
    {
      "name": "skill text",
      "match": [
        "skills/**/*.md"
      ],
      "commands": [],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "kill-ai-slop"
      ],
      "ciRequired": true,
      "try": "code"
    },
    {
      "name": "docs",
      "match": [
        "docs/**",
        "**/*.md"
      ],
      "commands": [],
      "checks": [
        "Test scope"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "kill-ai-slop"
      ],
      "try": "code"
    },
    {
      "name": "tests",
      "match": [
        "**/*.test.ts"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "css",
        "build"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "audit-tests"
      ],
      "ciRequired": true,
      "try": "code"
    },
    {
      "name": "UI",
      "match": [
        "web/**"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "css",
        "build"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "review-code",
        "audit-tests",
        "kill-ai-slop",
        "write-front-end"
      ],
      "ciRequired": true,
      "try": "ui"
    },
    {
      "name": "back-end",
      "match": [
        "**"
      ],
      "commands": [
        "lint:fix",
        "typecheck",
        "css",
        "build"
      ],
      "checks": [
        "Lint, build and tests"
      ],
      "instructions": [
        "project",
        "follow-conventions",
        "review-code",
        "audit-tests",
        "kill-ai-slop"
      ],
      "ciRequired": true,
      "try": "code"
    }
  ],
  "instructions": {
    "project": "AGENTS.md",
    "write-front-end": ".agents/skills/write-front-end/SKILL.md",
    "write-ci-workflow": ".agents/skills/write-ci-workflow/SKILL.md",
    "follow-conventions": ".agents/skills/follow-conventions/SKILL.md"
  },
  "checkFixAttempts": 1,
  "agentTimeoutMinutes": 45,
  "tryNotes": "Give each trial a fresh scratch home. Run the web app with `PNYX_DEV_HOME=<scratch dir> pnpm dev`. Its backend defaults to port 4319. If that port is in use, serve the built app on an assigned port instead. After `pnpm build`, run `PNYX_HOME=<scratch dir> node dist/cli/pnyx-axi.js serve --port 0`. Wait for the trial's server to start, then open the URL it serves (the URL Vite prints for `pnpm dev`) in a headless browser with its own profile. Stop the processes started for the trial when done. Leave the global `pnyx-axi`, pnyx.localhost, `~/.pnyx` and `~/.pnyx-dev` alone."
}
