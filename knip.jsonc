{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "entry": [
    // Worker URLs select the source or built extension at runtime.
    "src/oracle/search-worker.ts",
    "src/setup/hook-context.ts",
    // The test harness launches these files in child processes.
    "tests/setup/fixtures/**/*.{ts,mjs}"
  ],
  "ignoreBinaries": [
    "codex" // The owner's separately installed agent CLI.
  ]
}
